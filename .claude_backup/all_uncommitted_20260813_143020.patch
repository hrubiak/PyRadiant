+class RoiBgWidget(QtWidgets.QWidget):
+    """Diagnostic view of the kinetics-frame background.
+
+    View modes:
+      * 'reduced' — two side-by-side heatmaps (DS left, US right), one row
+        per frame, per-column bg sum. Same data that feeds the 'kinetics_trend'
+        linear fit.
+      * 'raw' — a single heatmap of the raw 2D bg ROI stacked across all
+        frames (frame 0 on top). Shows the underlying pixel drift.
+
