+        self.mode_combo.currentIndexChanged.connect(self._on_mode_index_changed)
+
+    # -- mode -----------------------------------------------------------------
+    def current_mode(self):
+        """Return 'reduced' or 'raw'."""
+        return 'raw' if self.mode_combo.currentIndex() == 1 else 'reduced'
+
+    def _on_mode_index_changed(self, _idx):
+        mode = self.current_mode()
+        if mode == 'raw':
+            self._ds_pg_widget.hide()
+            self._us_pg_widget.hide()
+            self._raw_pg_widget.show()
+        else:
+            self._raw_pg_widget.hide()
+            self._ds_pg_widget.show()
+            self._us_pg_widget.show()
+        self.mode_changed.emit(mode)
+
+    # -- panels ---------------------------------------------------------------
+    def _make_panel(self, title, title_color, cmap, y_label='frame index'):
+        pg_widget = pg.GraphicsLayoutWidget()
+        pg_layout = pg_widget.ci
+        pg_layout.setContentsMargins(0, 10, 15, 0)
+
+        plot = pg_layout.addPlot(row=0, col=0)
+        plot.setTitle(title, color=title_color, size='12pt')
+        plot.setLabel('bottom', 'column (px within bg ROI)')
+        plot.setLabel('left', y_label)
+        plot.getViewBox().invertY(True)
+
+        img_item = pg.ImageItem()
+        plot.addItem(img_item)
+
+        marker = pg.InfiniteLine(angle=0, movable=False,
+                                 pen=pg.mkPen(title_color, width=1, style=QtCore.Qt.PenStyle.DashLine))
+        marker.hide()
+        plot.addItem(marker)
+
+        hist_item = HistogramLUTItem(img_item)
+        hist_item.axis.setStyle(showValues=False)
+        hist_item.setFixedWidth(70)
+        hist_item.gradient.setColorMap(cmap)
+        pg_layout.addItem(hist_item, row=0, col=1)
+
+        return pg_widget, img_item, marker, hist_item
+
+    # -- reduced-mode data ----------------------------------------------------
+    def set_bg_matrix(self, side, matrix):
+        """Push the (N × W_roi) bg matrix into the DS or US panel. Pass None
+        to clear that side (e.g., non-kinetics data)."""
+        img_item = self._ds_img_item if side == 'ds' else self._us_img_item
+        marker = self._ds_marker if side == 'ds' else self._us_marker
+        if matrix is None or not hasattr(matrix, 'shape') or matrix.size == 0:
+            img_item.clear()
+            marker.hide()
+            return
+        img_item.setImage(np.asarray(matrix).T, autoLevels=True)
+
+    def set_current_frame(self, side, frame):
+        """Show or hide the horizontal frame marker in the reduced view."""
+        marker = self._ds_marker if side == 'ds' else self._us_marker
+        if frame is None:
+            marker.hide()
+            return
+        marker.setPos(float(frame) + 0.5)
+        marker.show()
+
+    # -- raw-mode data --------------------------------------------------------
+    def set_raw_stack(self, matrix, h_roi):
+        """Push the (N*H_roi × W_roi) raw 2D stacked bg into the single raw
+        panel. Pass matrix=None to clear."""
+        if matrix is None or not hasattr(matrix, 'shape') or matrix.size == 0:
+            self._raw_img_item.clear()
+            self._raw_marker.hide()
+            self._h_roi = 1
+            return
+        self._h_roi = max(1, int(h_roi))
+        self._raw_img_item.setImage(np.asarray(matrix).T, autoLevels=True)
+
+    def set_raw_current_frame(self, frame):
+        """Place the frame marker at the center of the given frame's row block."""
+        if frame is None:
+            self._raw_marker.hide()
+            return
+        self._raw_marker.setPos(float(frame) * self._h_roi + self._h_roi / 2.0)
+        self._raw_marker.show()
+
+
