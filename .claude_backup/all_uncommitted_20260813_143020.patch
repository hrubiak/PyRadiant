+    # -------- Kinetics-trend background ---------------------------------------
+    def _invalidate_bg_trend(self, side=None):
+        """Drop the cached per-column bg trend fit so it recomputes on next use.
+        Call with side='ds'|'us' to clear one, or side=None to clear both.
+        Cheap; safe to over-call."""
+        if side is None:
+            self._bg_trend_cache = {'ds': None, 'us': None}
+        else:
+            self._bg_trend_cache[side] = None
+
+    def _compute_bg_trend(self, side):
+        """Fit a per-column linear trend (in frame index) to the bg ROI stacked
+        across all kinetics frames on one side. Returns the cache dict or
+        None if kinetics data isn't loaded."""
+        if self.data_img_file is None:
+            return None
+        n = int(getattr(self.data_img_file, 'num_frames', 0) or 0)
+        if n <= 1:
+            return None
+        # Derive dim from the first frame; _data_img_dimension lives on the
+        # SingleTemperatureModel children, not on the config.
+        first = np.asarray(self.data_img_file.img[0])
+        h, w = first.shape
+        dim = (w, h)
+        roi_idx = 2 if side == 'ds' else 3
+        roi = validate_roi(self.roi_data_manager.get_roi(roi_idx, dim))
+        # Clamp to first-frame extents (all frames share shape).
+        if roi.x_max >= w:
+            roi.x_max = w - 1
+        if roi.y_max >= h:
+            roi.y_max = h - 1
+        x_min, x_max = int(roi.x_min), int(roi.x_max)
+        # Stack per-column bg sums: shape (N, W_roi).
+        W_roi = x_max - x_min + 1
+        B = np.empty((n, W_roi), dtype=float)
+        for f in range(n):
+            B[f, :] = get_roi_sum(np.asarray(self.data_img_file.img[f]), roi)
+        # Robust contamination reject on per-frame totals.
+        totals = B.sum(axis=1)
+        med = float(np.median(totals))
+        mad = 1.4826 * float(np.median(np.abs(totals - med)))
+        if mad > 0:
+            clean_mask = totals <= med + 5.0 * mad
+        else:
+            clean_mask = np.ones(n, dtype=bool)
+        # Never let the mask collapse to too few points for a stable line fit.
+        if int(clean_mask.sum()) < 3:
+            clean_mask = np.ones(n, dtype=bool)
+        clean_idx = np.where(clean_mask)[0]
+        masked_frames = [int(i) for i in np.where(~clean_mask)[0]]
+        # Vectorized per-column linear fit: solve A @ [slope, intercept] = B_clean.
+        A = np.stack([clean_idx.astype(float), np.ones_like(clean_idx, dtype=float)], axis=1)
+        coeffs, *_ = np.linalg.lstsq(A, B[clean_idx, :], rcond=None)
+        slope, intercept = coeffs[0], coeffs[1]
+        entry = {
+            'intercept': intercept,
+            'slope': slope,
+            'x_min': x_min,
+            'x_max': x_max,
+            'masked_frames': masked_frames,
+            # Raw per-column bg matrix (frame × column) that fed the fit.
+            # Kept for the BG diagnostic tab; cheap even for a few hundred frames.
+            'B': B,
+        }
+        self._bg_trend_cache[side] = entry
+        return entry
+
+    def get_bg_trend(self, side):
+        """Return the cached per-column bg trend for one side, computing it
+        lazily on first request. Returns None for non-kinetics data."""
+        cache = self._bg_trend_cache.get(side)
+        if cache is not None:
+            return cache
+        return self._compute_bg_trend(side)
+
+    def get_bg_matrix(self, side):
+        """Return the (N × W_roi) per-column bg matrix that feeds the trend
+        fit for one side, computing on demand. None for non-kinetics data."""
+        trend = self.get_bg_trend(side)
+        if trend is None:
+            return None
+        return trend.get('B')
+
+    def get_bg_raw_stack(self, side='ds'):
+        """Return raw 2D bg ROI stacked across all kinetics frames.
+        Shape: (N * H_roi, W_roi). Also returns H_roi so callers can place
+        per-frame markers. Not cached — cheap enough to recompute on view.
+        Returns (None, 0) for non-kinetics data.
+        """
+        if self.data_img_file is None:
+            return None, 0
+        n = int(getattr(self.data_img_file, 'num_frames', 0) or 0)
+        if n <= 1:
+            return None, 0
+        first = np.asarray(self.data_img_file.img[0])
+        h, w = first.shape
+        dim = (w, h)
+        roi_idx = 2 if side == 'ds' else 3
+        roi = validate_roi(self.roi_data_manager.get_roi(roi_idx, dim))
+        if roi.x_max >= w:
+            roi.x_max = w - 1
+        if roi.y_max >= h:
+            roi.y_max = h - 1
+        x_min, x_max = int(roi.x_min), int(roi.x_max)
+        y_min, y_max = int(roi.y_min), int(roi.y_max)
+        h_roi = y_max - y_min + 1
+        w_roi = x_max - x_min + 1
+        stack = np.empty((n * h_roi, w_roi), dtype=float)
+        for f in range(n):
+            img = np.asarray(self.data_img_file.img[f])
+            stack[f * h_roi:(f + 1) * h_roi, :] = img[y_min:y_max + 1, x_min:x_max + 1]
+        return stack, h_roi
